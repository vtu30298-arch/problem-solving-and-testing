import java.util.*;

public class Solution {

    public static void matrixRotation(List<List<Integer>> matrix, int r) {
        int m = matrix.size();
        int n = matrix.get(0).size();

        int[][] a = new int[m][n];

        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                a[i][j] = matrix.get(i).get(j);
            }
        }

        int layers = Math.min(m, n) / 2;

        for (int layer = 0; layer < layers; layer++) {

            List<Integer> elements = new ArrayList<>();

            int top = layer;
            int left = layer;
            int bottom = m - 1 - layer;
            int right = n - 1 - layer;

            // Top row
            for (int j = left; j <= right; j++)
                elements.add(a[top][j]);

            for (int i = top + 1; i <= bottom; i++)
                elements.add(a[i][right]);

         
            for (int j = right - 1; j >= left; j--)
                elements.add(a[bottom][j]);

         
            for (int i = bottom - 1; i > top; i--)
                elements.add(a[i][left]);

            int len = elements.size();
            int shift = r % len;

            int index = 0;

            for (int j = left; j <= right; j++) {
                a[top][j] = elements.get((index + shift) % len);
                index++;
            }

            // Right column
            for (int i = top + 1; i <= bottom; i++) {
                a[i][right] = elements.get((index + shift) % len);
                index++;
            }

            // Bottom row
            for (int j = right - 1; j >= left; j--) {
                a[bottom][j] = elements.get((index + shift) % len);
                index++;
            }

            // Left column
            for (int i = bottom - 1; i > top; i--) {
                a[i][left] = elements.get((index + shift) % len);
                index++;
            }
        }

        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                System.out.print(a[i][j] + " ");
            }
            System.out.println();
        }
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int m = sc.nextInt();
        int n = sc.nextInt();
        int r = sc.nextInt();

        List<List<Integer>> matrix = new ArrayList<>();

        for (int i = 0; i < m; i++) {
            List<Integer> row = new ArrayList<>();

            for (int j = 0; j < n; j++) {
                row.add(sc.nextInt());
            }

            matrix.add(row);
        }

        matrixRotation(matrix, r);
    }
}
